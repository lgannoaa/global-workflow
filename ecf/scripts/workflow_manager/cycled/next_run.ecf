#PBS -S /bin/bash
#PBS -N %RUN%_next_run_%CYC%
#PBS -j oe
#PBS -q %QUEUE%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:30:00
#PBS -l place=vscatter,select=1:ncpus=1:mem=1GB
#PBS -l debug=true

model=gfs
%include <head.h>
%include <envir-p1.h>

set -x

export NET=%NET:gfs%
export RUN=%RUN%
export CDUMP=%RUN%

############################################################
# Load modules
############################################################

module list

export edate=%EDATE%
export cyc=%CYC%
export cycle=t${cyc}z
export CDATE="$PDY$cyc"
export EXPDIR=${EXPDIR:-$HOMEgfs/parm/config}
export DATA=${DATAROOT}/emc_ecflow_pdy.date.$$.$RANDOM
mkdir -p $DATA
cd $DATA
setpdy.sh
. ./PDY
setpdy.sh

if [ $cyc == 00 ]; then cyc_to_wait="06"; fi
if [ $cyc == 06 ]; then cyc_to_wait="12"; fi
if [ $cyc == 12 ]; then cyc_to_wait="18"; fi
if [ $cyc == 18 ]; then cyc_to_wait="00"; fi
if [ $cyc == 00 ]; then prev_cyc="18"; fi
if [ $cyc == 06 ]; then prev_cyc="00"; fi
if [ $cyc == 12 ]; then prev_cyc="06"; fi
if [ $cyc == 18 ]; then prev_cyc="12"; fi

mkdir -p $EXPDIR/logs
ecflowlog="$EXPDIR/logs/${CDATE}.log"
echo "This cycle is complete: Success" >> $ecflowlog

if [ $PDY == $edate ]; then
  ecflow_client --msg="***Cycled parallel run is completed***"
else
  ecflow_client --alter change variable PDY $PDYp1 /da_cycled_gfs/primary/${cyc}
  ecflow_client --msg="***Cycled parallel $PDY$cyc is done $PDYp1$cyc is in quote next***"
  ecflow_client --requeue=force /da_cycled_gfs/primary/${prev_cyc}

  #### Clean up old cycle to save space ####
  if [ $cyc == 18 ]; then
    cd $ROTDIR
#    find . -type f|grep -v "logs"|grep -v "\.sh"|grep -v "RESTART" | grep -v "sfluxgrb" | grep -v $PDY | grep -v $PDYp1 |grep -v "vrfyarch"|grep -v "atmanl"|grep -v "sfcanl"| awk '{print "rm -f ",$1}' &> tt_auto.sh
#    chmod 700 tt_auto.sh
#    sh tt_auto.sh;mv tt_auto.sh tt_auto-${PDY}.old
  fi
  if [ $cyc == 00 ]; then
    cd $ROTDIR
#    if [ -s enkfgdas.${PDYm1}/06 -a -s enkfgdas.${PDYm1}/12 ]; then
#      echo "Cycle 00z finished will remove enkfgdas.${PDYm1} 06 and 12 from COM to save space"
#      rm -rf enkfgdas.${PDYm1}/06
#      rm -rf enkfgdas.${PDYm1}/12
#    fi
  fi
  ecflow_client --alter add variable PDY ${PDY} /da_cycled_gfs/primary/emc_para_check
  ecflow_client --alter add variable CYC ${cyc} /da_cycled_gfs/primary/emc_para_check
  ecflow_client --alter add variable PDY ${PDY} /da_cycled_gfs/primary/emc_gplots
  ecflow_client --alter add variable CYC ${cyc} /da_cycled_gfs/primary/emc_gplots
fi

rm -rf $DATA

%include <tail.h>
%manual

%end

