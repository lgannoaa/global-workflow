#PBS -S /bin/bash
#PBS -N emc_para_check
#PBS -j oe
#PBS -q %QUEUE_ARCH%
#PBS -A %PROJ%-%PROJENVIR%
#PBS -l walltime=00:03:00
#PBS -l place=vscatter,select=1:ncpus=1:mem=1GB
#PBS -l debug=true

model=gfs
%include <head.h>
%include <envir-p1.h>
#### QUEUE_ARCH
set -x

export NET=%NET:gfs%

############################################################
# Load modules
############################################################
module load PrgEnv-intel/${PrgEnv_intel_ver}
module load craype/${craype_ver}
module load intel/${intel_ver}
module load perl/${perl_ver}
module load util_shared/${util_shared_ver}

module list

#############################################################
# WCOSS environment settings
#############################################################
export cyc=%CYC%
export cycle=t${cyc}z
export EXPDIR=${EXPDIR:-$HOMEgfs/parm/config}
export CDATE="$PDY$cyc"
export PSLOT=${PSLOT:-"retro1-v16-ecf"}

###############################################################
# Submit METPLUS plotting jobs
###############################################################
mkdir -p $PBS_O_WORKDIR/para_check_status
para_check_status_log=$PBS_O_WORKDIR/para_check_status/para_check_status.log
rm -f $para_check_status_log

export FAILED_ARCHIVE_RERUN=YES

PARACHECKSH=$HOME_emc_ecf_wm/scripts/para_check_status.sh
ksh $PARACHECKSH &>$PBS_O_WORKDIR/para_check_status/para_check_status.log
status=$?
[[ $status -ne 0 ]] && exit $status

HCOASH=$HOME_emc_ecf_wm/scripts/health_check_offline_archive.sh
sh $HCOASH $CDATE
status=$?
[[ $status -ne 0 ]] && exit $status

if [ "$FAILED_ARCHIVE_RERUN" = "YES" ]; then
  ARCHIVE_RERUN_FAILED_SH=$HOME_emc_ecf_wm/scripts/arch_rerun_failed.sh
  sh $ARCHIVE_RERUN_FAILED_SH
fi

cd $PBS_O_WORKDIR/para_check_status

if [ ! -s ${HOMEgfs}/ecf/scripts/workflow_manager/scripts/mailx ]; then
  ln -s ${HOMEgfs}/ecf/scripts/workflow_manager/scripts/mailx
fi
echo "GFS Cactus ecflow paralel check" | mailx -s "ECFLOW para_check_status ${PSLOT}" -a ${para_check_status_log} lin.gan@noaa.gov
#### echo "GFS ecflow paralel check test only" | mailx -s "ECFLOW para_check_status ${PSLOT}" -a ${para_check_status_log} lin.gan@noaa.gov -c emily.liu@noaa.gov russ.treadon@noaa.gov

trap 0

%include <tail.h>
%manual

%end
