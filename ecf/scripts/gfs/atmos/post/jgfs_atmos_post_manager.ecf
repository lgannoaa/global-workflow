#!/bin/bash
#SBATCH -J %RUN%_atmos_post_manager_%CYC%
#SBATCH -o %RUN%_atmos_post_manager_%CYC%.o%j
#SBATCH -A %HERA_ACCOUNT%
#SBATCH -q %QUEUE%
#SBATCH --nodes=1
#SBATCH --cpus-per-task=1
#SBATCH --ntasks-per-node=1
#SBATCH --time=8:00:00
#SBATCH --verbose

model=gfs
%include <head.h>
%include <envir-p1.h>

set -x

export NET=%NET:gfs%
export RUN=%RUN%
export COMPONENT=${COMPONENT:-atmos}
export CDUMP=%RUN%

############################################################
# Load modules
############################################################

module list

export cyc=%CYC%
export cycle=t%CYC%z

export COMIN=$ROTDIR/$RUN.$PDY/$cyc/$COMPONENT
export COMOUT=$ROTDIR/$RUN.$PDY/$cyc/$COMPONENT
############################################################
# CALL executable job script here
############################################################
${HOMEgfs}/jobs/JGLOBAL_ATMOS_POST_MANAGER

if [ $? -ne 0 ]; then
   ecflow_client --msg="***JOB ${ECF_NAME} ERROR RUNNING J-SCRIPT ***"
   ecflow_client --abort
   exit
fi

%include <tail.h>
%manual

%end
