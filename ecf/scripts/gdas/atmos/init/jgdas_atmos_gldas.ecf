####BSUB -L /bin/sh
####BSUB -J %E%gdas_atmos_gldas_%CYC%
####BSUB -o %COM%/output/%ENVIR%/today/gdas_atmos_gldas_%CYC%.o%J
####BSUB -q %QUEUE%
####BSUB -P %PROJ%
####BSUB -W 0:20
